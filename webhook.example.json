[{
  "id": "deploy",
  "execute-command": "/www/wwwroot/picmi/deploy.sh",
  "command-working-directory": "/www/wwwroot/picmi",
  "response-message": "deploying",
  "pass-arguments-to-command": [],
  "trigger-rule": {
    "and": [
      {
        "match": {
          "type": "payload-hash-sha256",
          "secret": "YOUR_WEBHOOK_SECRET",
          "parameter": {
            "source": "header",
            "name": "X-Hub-Signature-256"
          }
        }
      },
      {
        "match": {
          "type": "value",
          "value": "refs/heads/main",
          "parameter": {
            "source": "payload",
            "name": "ref"
          }
        }
      }
    ]
  }
}]
